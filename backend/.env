# ============================================================
# 竞品分析 Agent 系统 配置文件
# 使用方法: 复制为 .env 并填入真实值
#   cp .env .env
# ============================================================

# --- LLM 配置 ---
# API 密钥（必填）。DeepSeek 注册地址: https://platform.deepseek.com/
LLM_API_KEY=sk-your-api-key-here
# API 地址（支持任意兼容 OpenAI 协议的服务商）
LLM_BASE_URL=https://api.deepseek.com/v1
# 模型名称
LLM_MODEL=deepseek-chat

# --- 服务配置 ---
# --- 服务配置 ---
HOST=0.0.0.0
PORT=8000

# --- Embedding 模型 ---
# 用于文本转向量，中文推荐 bge-small-zh-v1.5
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5

# --- 数据库 ---
# 开发环境用 SQLite，生产环境改成 PostgreSQL 连接串
# DATABASE_URL 不用写，代码自动用 backend/data/products.db 绝对路径

# --- 短板深挖阈值 ---
# 当本品某维度评分低于该值时触发 deep_dive_node
DEEP_DIVE_THRESHOLD=60
